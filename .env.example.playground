# Vercel project env for /playground (Settings → Environment Variables)
#
# Required — copy from CeRebel/.env.product (or ~/Qwen_KEY.txt):
MOTION_AGENT_API_KEY=
#
# Optional — already defaulted to the live product values; set only to override:
# MOTION_AGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MOTION_AGENT_MODEL=qwen3.7-plus
# MOTION_AGENT_MAX_TOOL_CALLS=8
#
# GEM-X GPU box (public 8091 tunnel) — also defaulted in code; set to override:
