# Copy this file to .env.local and add your React Bits Pro license key.
# Do not commit .env.local.
REACTBITS_LICENSE_KEY=

# Production builds send backer sign-ups to Supabase by default. Set these to override, or to test locally.
# VITE_BACKER_ENDPOINT=
# VITE_BACKER_API_KEY=
# The Request a Demo form works the same way (deploy/supabase-demo-requests.sql creates its function).
# VITE_DEMO_ENDPOINT=
# Where page views and heartbeats go. This is also the default when unset.
VITE_EVENTS_ENDPOINT=/playground/api/site/ping
