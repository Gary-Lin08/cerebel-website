# Do not commit .env.local.
REACTBITS_LICENSE_KEY=

# Production builds send backer sign-ups to Supabase by default. Set these to override, or to test locally.
# VITE_BACKER_ENDPOINT=
# VITE_BACKER_API_KEY=
# Production builds send page views and heartbeats to Supabase by default. Set these to override, or to test locally.
# VITE_EVENTS_ENDPOINT=
# VITE_EVENTS_API_KEY=
