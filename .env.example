# Copy this file to .env.local and add your React Bits Pro license key.
# Do not commit .env.local.
REACTBITS_LICENSE_KEY=

# Vercel Edge middleware: GPU / Playground origin used for document-open health + HTML.
# Defaults to the onething tunnel hostname if unset. Set this in the Vercel project env
# when the tunnel URL changes (same value as CeRebel CEREBEL_UPLOAD_ORIGIN).
# PLAYGROUND_ORIGIN=https://0i5-79nucyondu7h6sp1a-cdhea2bq-custom.service.onethingrobot.com

# Production builds send backer sign-ups to Supabase by default. Set these to override, or to test locally.
# VITE_BACKER_ENDPOINT=
# VITE_BACKER_API_KEY=
# Production builds send page views and heartbeats to Supabase by default. Set these to override, or to test locally.
# VITE_EVENTS_ENDPOINT=
# VITE_EVENTS_API_KEY=
# The Request a Demo form works the same way (deploy/supabase-demo-requests.sql creates its function).
# VITE_DEMO_ENDPOINT=
